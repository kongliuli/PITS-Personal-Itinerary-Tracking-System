<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:PITS.MVP.App.Converters"
             x:Class="PITS.MVP.App.App">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Merge Dark Aggressive Theme -->
            <ResourceDictionary Source="Styles/DarkTheme.xaml"/>

            <!-- Converters -->
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToLayoutConverter x:Key="BoolToLayoutConverter"/>
            <converters:BoolToTextColorConverter x:Key="BoolToTextColorConverter"/>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:NotNullOrEmptyStringConverter x:Key="NotNullOrEmptyStringConverter"/>

            <!-- Override implicit styles so every page auto-inherits dark theme -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentPrimary}"/>
                <Setter Property="TextColor" Value="{StaticResource TextOnAccent}"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="24,14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BgCard}"/>
                <Setter Property="BorderColor" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="HasShadow" Value="False"/>
            </Style>

            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource BgPrimary}"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
