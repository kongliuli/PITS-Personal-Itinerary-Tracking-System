<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PITS.MVP.App.ViewModels"
             x:Class="PITS.MVP.App.Views.CalendarPage"
             Title="日历">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <Frame Grid.Row="0" Margin="15,10" Padding="12" BackgroundColor="#FFF3E0"
               BorderColor="#FFB74D" IsVisible="{Binding OnThisDaySummary, Converter={StaticResource NotNullOrEmptyStringConverter}}"
               CornerRadius="10">
            <VerticalStackLayout>
                <Label Text="🕰️ 去年今日" FontAttributes="Bold" FontSize="15" TextColor="#E65100"/>
                <Label Text="{Binding OnThisDaySummary}" FontSize="13" TextColor="#5D4037"
                       Margin="0,4,0,0" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Frame>

        <Grid ColumnDefinitions="Auto,*,Auto" Padding="15" Grid.Row="1">
            <Button Text="◀" Command="{Binding PrevMonthCommand}" WidthRequest="50"/>
            <Label Text="{Binding CurrentMonthLabel}" 
                   HorizontalOptions="Center" FontAttributes="Bold" FontSize="18"
                   Grid.Column="1" VerticalOptions="Center"/>
            <Button Text="▶" Command="{Binding NextMonthCommand}" Grid.Column="2" WidthRequest="50"/>
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding CalendarDays}">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="5" BorderColor="{Binding BorderColor}" HeightRequest="60">
                        <VerticalStackLayout HorizontalOptions="Fill">
                            <Label Text="{Binding DayNumber}" 
                                   HorizontalOptions="End" FontSize="14"/>
                            <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                <BindableLayout.ItemsSource>
                                    <Binding Path="Indicators"/>
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <BoxView Color="{Binding Color}" 
                                                 WidthRequest="6" HeightRequest="6"
                                                 CornerRadius="3"/>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CalendarViewModel}}, Path=SelectDayCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Frame Grid.Row="3" VerticalOptions="End" Margin="10" Padding="10"
               IsVisible="{Binding HasSelectedDay}" HeightRequest="220">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,*,Auto,Auto" Padding="6,0,6,4">
                    <Label Text="计划" FontAttributes="Bold" FontSize="13"/>
                    <Label Text="实际" Grid.Column="1" FontAttributes="Bold" FontSize="13"/>
                    <Label Text="偏差" Grid.Column="2" FontAttributes="Bold" FontSize="13"/>
                    <Label Text="状态" Grid.Column="3" FontAttributes="Bold" FontSize="13"/>
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding SelectedDayComparisons}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,*,Auto,Auto" Padding="6" ColumnSpacing="8">
                                <VerticalStackLayout>
                                    <Label Text="{Binding PlannedTime}" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding PlannedTitle}" FontSize="13" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding ActualTime}" FontSize="12" TextColor="Gray"/>
                                    <Label Text="{Binding ActualTitle}" FontSize="13" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding Delta}" FontSize="12" VerticalOptions="Center"/>
                                <Frame Grid.Column="3" Padding="6,2" CornerRadius="8"
                                       BackgroundColor="{Binding StatusColor}" VerticalOptions="Center">
                                    <Label Text="{Binding Status}" TextColor="White" FontSize="11"/>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Frame>
        
    </Grid>
</ContentPage>
