<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PITS.MVP.App.Views.SettingsPage"
             Title="设置">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame>
                <VerticalStackLayout Spacing="15">
                    <Label Text="默认设置" FontAttributes="Bold" FontSize="16"/>
                    
                    <Label Text="默认可见性级别"/>
                    <Picker ItemsSource="{Binding VisibilityLevels}"
                            SelectedItem="{Binding DefaultVisibility}"/>
                    
                    <Label Text="后台定位"/>
                    <Switch IsToggled="{Binding EnableBackgroundLocation}"/>
                    
                    <Label Text="地理围栏半径 (米)"/>
                    <Entry Text="{Binding GeofenceRadius}" Keyboard="Numeric"/>
                </VerticalStackLayout>
            </Frame>

            <Frame>
                <VerticalStackLayout Spacing="15">
                    <Label Text="轨迹分类设置" FontAttributes="Bold" FontSize="16"/>

                    <Label Text="停留半径 (米)"/>
                    <Slider Minimum="10" Maximum="200" Value="{Binding StayRadius}"/>
                    <Label Text="{Binding StayRadius, StringFormat='{0:F0} 米'}" HorizontalOptions="End" TextColor="Gray"/>

                    <Label Text="最短停留时长 (分钟)"/>
                    <Slider Minimum="1" Maximum="30" Value="{Binding StayDurationMinutes}"/>
                    <Label Text="{Binding StayDurationMinutes, StringFormat='{0:F0} 分钟'}" HorizontalOptions="End" TextColor="Gray"/>

                    <Label Text="数据缺口阈值 (分钟)"/>
                    <Slider Minimum="5" Maximum="120" Value="{Binding GapThresholdMinutes}"/>
                    <Label Text="{Binding GapThresholdMinutes, StringFormat='{0:F0} 分钟'}" HorizontalOptions="End" TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <Frame>
                <VerticalStackLayout Spacing="15">
                    <Label Text="Home Assistant MQTT 集成" FontAttributes="Bold" FontSize="16"/>

                    <Label Text="启用 MQTT 位置发布"/>
                    <Switch IsToggled="{Binding MqttEnabled}"/>

                    <Label Text="MQTT 服务器地址"/>
                    <Entry Text="{Binding MqttHost}" Placeholder="例: 192.168.1.100" IsEnabled="{Binding MqttEnabled}"/>

                    <Label Text="MQTT 端口"/>
                    <Entry Text="{Binding MqttPort}" Keyboard="Numeric" IsEnabled="{Binding MqttEnabled}"/>

                    <Label Text="用户名"/>
                    <Entry Text="{Binding MqttUsername}" Placeholder="可选" IsEnabled="{Binding MqttEnabled}"/>

                    <Label Text="密码"/>
                    <Entry Text="{Binding MqttPassword}" IsPassword="True" Placeholder="可选" IsEnabled="{Binding MqttEnabled}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame>
                <VerticalStackLayout Spacing="15">
                    <Label Text="数据导出" FontAttributes="Bold" FontSize="16"/>
                    
                    <Button Text="导出 GeoJSON" Command="{Binding ExportGeoJsonCommand}"/>
                    <Button Text="导出 CSV" Command="{Binding ExportCsvCommand}"/>
                    <Button Text="导出 GPX" Command="{Binding ExportGpxCommand}"/>
                </VerticalStackLayout>
            </Frame>

            <Frame>
                <VerticalStackLayout Spacing="10">
                    <Label Text="关于" FontAttributes="Bold" FontSize="16"/>
                    <Label Text="PITS MVP v1.0.0" TextColor="Gray"/>
                    <Label Text="个人行程追踪系统" TextColor="Gray" FontSize="12"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
