<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="PITS.MVP.App.Views.MapPage"
             Title="轨迹地图">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <maps:Map x:Name="TripMap" Grid.Row="0" Grid.RowSpan="3"
                  IsShowingUser="True" MapType="Street"/>

        <!-- 速度图例 -->
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" Margin="0,5,10,0">
            <Frame BackgroundColor="#80FFFFFF" Padding="5,3" CornerRadius="5">
                <HorizontalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="2">
                        <BoxView Color="DodgerBlue" WidthRequest="12" HeightRequest="4"/>
                        <Label Text="步行" FontSize="10"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <BoxView Color="LimeGreen" WidthRequest="12" HeightRequest="4"/>
                        <Label Text="骑车" FontSize="10"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <BoxView Color="Orange" WidthRequest="12" HeightRequest="4"/>
                        <Label Text="驾车" FontSize="10"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <BoxView Color="Red" WidthRequest="12" HeightRequest="4"/>
                        <Label Text="高速" FontSize="10"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </Frame>
        </HorizontalStackLayout>

        <Frame Grid.Row="0" VerticalOptions="Start" HorizontalOptions="Start"
               Margin="10" Padding="10" BackgroundColor="White" Opacity="0.95">
            <VerticalStackLayout Spacing="5">
                <Label Text="时间范围" FontAttributes="Bold" FontSize="12"/>
                <Picker ItemsSource="{Binding TimeOptions}"
                        SelectedItem="{Binding SelectedTimeRange}"/>
                <HorizontalStackLayout Margin="0,5,0,0">
                    <Label Text="速度着色" FontSize="12" VerticalOptions="Center"/>
                    <Switch IsToggled="{Binding UseSpeedColors}" Margin="5,0,0,0"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <Frame Grid.Row="2" VerticalOptions="End" Margin="10" Padding="10"
               BackgroundColor="White" Opacity="0.95">
            <Label Text="点击地图查看行程详情" FontSize="12" TextColor="Gray"/>
        </Frame>
    </Grid>
</ContentPage>
