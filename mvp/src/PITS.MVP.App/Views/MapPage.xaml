<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PITS.MVP.App.Views.MapPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BgPrimary}">
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Padding="20,26,20,14" ColumnDefinitions="44,*,44"
              MaximumWidthRequest="720"
              HorizontalOptions="Fill">
            <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                <Label Text="轨迹概览"
                       Style="{StaticResource PageTitle}"
                       Margin="0"/>
                <Label Text="{Binding Summary}"
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
            <Button Grid.Column="2"
                    Text="↻"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource GhostButton}"
                    FontSize="18"
                    Padding="0"
                    WidthRequest="40"
                    HeightRequest="38"
                    VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="1" Padding="20,0,20,12" ColumnDefinitions="*,*" ColumnSpacing="10"
              MaximumWidthRequest="720"
              HorizontalOptions="Fill">
            <Border Padding="14,10"
                    BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderSubtle}"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="时间范围"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"/>
                    <Picker ItemsSource="{Binding TimeOptions}"
                            SelectedItem="{Binding SelectedTimeRange}"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}"/>
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1"
                    Padding="14,10"
                    BackgroundColor="{StaticResource BgCard}"
                    Stroke="{StaticResource BorderSubtle}"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="4">
                    <Label Text="可见范围"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"/>
                    <Picker ItemsSource="{Binding LayerOptions}"
                            SelectedItem="{Binding SelectedLayer}"
                            FontSize="14"
                            TextColor="{StaticResource TextPrimary}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Trips}" Margin="20,0,20,20"
                            MaximumWidthRequest="720"
                            HorizontalOptions="Fill">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="16"
                                BackgroundColor="{StaticResource BgCard}"
                                Stroke="{StaticResource BorderSubtle}"
                                StrokeShape="RoundRectangle 16">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"/>
                                <Border Grid.Column="1"
                                        Padding="10,4"
                                        BackgroundColor="{Binding BadgeColor}"
                                        StrokeShape="RoundRectangle 50">
                                    <Label Text="{Binding Badge}"
                                           TextColor="{StaticResource TextOnAccent}"
                                           FontSize="11"/>
                                </Border>

                                <Label Grid.Row="1"
                                       Text="{Binding Location}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}"
                                       LineBreakMode="TailTruncation"/>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Time}" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                                    <Label Grid.Column="1" Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding EmptyMessage}"
                   IsVisible="{Binding IsEmpty}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="15"/>

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   Margin="28"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource AccentDanger}"
                   FontSize="13"/>
        </Grid>
    </Grid>
</ContentPage>
