<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PITS.MVP.App.Views.MapPage"
             Title="轨迹">
    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="#F6F8FA">
        <Grid Grid.Row="0" Padding="18,16" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="4">
                <Label Text="轨迹概览" FontSize="24" FontAttributes="Bold" TextColor="#17202A"/>
                <Label Text="{Binding Summary}" FontSize="13" TextColor="#607080"/>
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="刷新"
                    Command="{Binding RefreshCommand}"
                    WidthRequest="76"
                    HeightRequest="38"
                    Padding="10,0"
                    VerticalOptions="Center"/>
        </Grid>

        <Grid Grid.Row="1" Padding="18,0,18,12" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Frame Padding="12,8" CornerRadius="8" BackgroundColor="White" BorderColor="#DDE4EC">
                <VerticalStackLayout Spacing="4">
                    <Label Text="时间范围" FontSize="12" TextColor="#607080"/>
                    <Picker ItemsSource="{Binding TimeOptions}"
                            SelectedItem="{Binding SelectedTimeRange}"
                            FontSize="14"/>
                </VerticalStackLayout>
            </Frame>
            <Frame Grid.Column="1" Padding="12,8" CornerRadius="8" BackgroundColor="White" BorderColor="#DDE4EC">
                <VerticalStackLayout Spacing="4">
                    <Label Text="可见范围" FontSize="12" TextColor="#607080"/>
                    <Picker ItemsSource="{Binding LayerOptions}"
                            SelectedItem="{Binding SelectedLayer}"
                            FontSize="14"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <Grid Grid.Row="2">
            <CollectionView ItemsSource="{Binding Trips}" Margin="18,0,18,18">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,10" Padding="14" CornerRadius="8"
                               BackgroundColor="White" BorderColor="#E2E8F0">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                <Label Text="{Binding Title}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#1B2631"
                                       LineBreakMode="TailTruncation"/>
                                <Frame Grid.Column="1" Padding="8,3" CornerRadius="8"
                                       BackgroundColor="{Binding BadgeColor}"
                                       HasShadow="False">
                                    <Label Text="{Binding Badge}" TextColor="White" FontSize="11"/>
                                </Frame>

                                <Label Grid.Row="1"
                                       Text="{Binding Location}"
                                       FontSize="13"
                                       TextColor="#607080"
                                       LineBreakMode="TailTruncation"/>

                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Time}" FontSize="12" TextColor="#7B8794"/>
                                    <Label Grid.Column="1" Text="{Binding Detail}" FontSize="12" TextColor="#7B8794"/>
                                </Grid>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="{Binding EmptyMessage}"
                   IsVisible="{Binding IsEmpty}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="#7B8794"
                   FontSize="15"/>
        </Grid>
    </Grid>
</ContentPage>
