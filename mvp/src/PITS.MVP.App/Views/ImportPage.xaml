<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PITS.MVP.App.ViewModels"
             x:Class="PITS.MVP.App.Views.ImportPage"
             x:DataType="vm:ImportViewModel"
             BackgroundColor="{StaticResource BgPrimary}">

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource PageStack}">

            <!-- 页面标题区 -->
            <Label Text="导入位置历史"
                   Style="{StaticResource PageTitle}"/>

            <Label Text="从 Google Takeout、GPX、日历或邮件中导入您的位置历史数据"
                   Style="{StaticResource PageSubtitle}"/>

            <!-- Google Takeout 导入卡片 -->
            <Frame Padding="0"
                   BackgroundColor="{StaticResource BgCard}"
                   BorderColor="{StaticResource BorderSubtle}"
                   CornerRadius="16"
                   HasShadow="False">
                <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                    <!-- 左侧彩色竖条 -->
                    <BoxView Color="{StaticResource AccentPrimary}" WidthRequest="4"/>

                    <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="12">
                        <Label Text="Google Takeout"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="从 Google 位置历史导出的 JSON 文件"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Button Text="选择 JSON 文件"
                                Command="{Binding ImportGoogleTakeoutCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource AccentPrimary}"
                                TextColor="{StaticResource TextOnAccent}"
                                CornerRadius="14"
                                HeightRequest="46"
                                HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- GPX 导入卡片 -->
            <Frame Padding="0"
                   BackgroundColor="{StaticResource BgCard}"
                   BorderColor="{StaticResource BorderSubtle}"
                   CornerRadius="16"
                   HasShadow="False">
                <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                    <BoxView Color="{StaticResource AccentSuccess}" WidthRequest="4"/>

                    <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="12">
                        <Label Text="GPX 文件"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="标准 GPS 交换格式文件"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Button Text="选择 GPX 文件"
                                Command="{Binding ImportGpxCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource AccentSuccess}"
                                TextColor="#0A0A0F"
                                CornerRadius="14"
                                HeightRequest="46"
                                HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- ICS 日历导入卡片 -->
            <Frame Padding="0"
                   BackgroundColor="{StaticResource BgCard}"
                   BorderColor="{StaticResource BorderSubtle}"
                   CornerRadius="16"
                   HasShadow="False">
                <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                    <BoxView Color="{StaticResource AccentSecondary}" WidthRequest="4"/>

                    <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="12">
                        <Label Text="ICS 日历"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="从日历文件导入待执行计划"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Button Text="选择 ICS 文件"
                                Command="{Binding ImportIcsCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource AccentSecondary}"
                                TextColor="{StaticResource TextOnAccent}"
                                CornerRadius="14"
                                HeightRequest="46"
                                HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- 邮件确认单导入卡片 -->
            <Frame Padding="0"
                   BackgroundColor="{StaticResource BgCard}"
                   BorderColor="{StaticResource BorderSubtle}"
                   CornerRadius="16"
                   HasShadow="False">
                <Grid ColumnDefinitions="4,*" ColumnSpacing="0">
                    <BoxView Color="{StaticResource AccentTertiary}" WidthRequest="4"/>

                    <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="12">
                        <Label Text="邮件确认单"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="从邮件文本或 EML 中提取行程计划"
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"/>
                        <Button Text="选择邮件文件"
                                Command="{Binding ImportEmailCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{StaticResource AccentTertiary}"
                                TextColor="{StaticResource TextOnAccent}"
                                CornerRadius="14"
                                HeightRequest="46"
                                HorizontalOptions="Fill"/>
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <!-- 进度区域 -->
            <VerticalStackLayout IsVisible="{Binding IsImporting}" Spacing="8">
                <ProgressBar Progress="{Binding ImportProgress}"
                             ProgressColor="{StaticResource AccentPrimary}"
                             BackgroundColor="{StaticResource BgElevated}"/>
                <Label Text="{Binding ImportStatus}"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- 结果卡片 -->
            <Frame IsVisible="{Binding ImportResult, Converter={StaticResource NotNullOrEmptyStringConverter}}"
                   Padding="16"
                   BackgroundColor="{StaticResource BgCard}"
                   BorderColor="{StaticResource AccentSuccess}"
                   CornerRadius="16"
                   HasShadow="False">
                <Label Text="{Binding ImportResult}"
                       FontSize="14"
                       TextColor="{StaticResource TextPrimary}"/>
            </Frame>

            <Frame IsVisible="{Binding HasPendingItems}"
                   Padding="16"
                   BackgroundColor="{StaticResource BgCard}"
                   BorderColor="{StaticResource BorderSubtle}"
                   CornerRadius="16"
                   HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="待确认"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <CollectionView ItemsSource="{Binding PendingItems}" HeightRequest="260">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      Padding="0,8"
                                      ColumnSpacing="10"
                                      RowSpacing="6">
                                    <Label Text="{Binding Title}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Source}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextTertiary}"/>
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding StartsAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                           FontSize="12"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <HorizontalStackLayout Grid.Row="2"
                                                           Grid.ColumnSpan="2"
                                                           Spacing="8">
                                        <Button Text="确认行程"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfirmAsTripCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource GhostButton}"
                                                FontSize="12"
                                                HeightRequest="34"/>
                                        <Button Text="确认计划"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfirmAsPlanCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource GhostButton}"
                                                FontSize="12"
                                                HeightRequest="34"/>
                                        <Button Text="忽略"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SkipPendingCommand}"
                                                CommandParameter="{Binding .}"
                                                Style="{StaticResource DangerButton}"
                                                FontSize="12"
                                                HeightRequest="34"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
