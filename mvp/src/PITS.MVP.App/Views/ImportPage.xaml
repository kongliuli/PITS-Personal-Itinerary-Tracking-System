<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PITS.MVP.App.ViewModels"
             x:Class="PITS.MVP.App.Views.ImportPage"
             x:DataType="vm:ImportViewModel"
             Title="数据导入">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="导入位置历史" FontSize="24" FontAttributes="Bold"/>

        <Label Text="从 Google Takeout 或 GPX 文件导入您的位置历史数据" FontSize="14" TextColor="Gray"/>

        <!-- Google Takeout 导入 -->
        <Frame Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="Google Takeout" FontSize="18" FontAttributes="Bold"/>
                <Label Text="从 Google 位置历史导出的 JSON 文件" FontSize="12" TextColor="Gray"/>
                <Button Text="选择 JSON 文件"
                        Command="{Binding ImportGoogleTakeoutCommand}"
                        IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#2196F3" TextColor="White"/>
            </VerticalStackLayout>
        </Frame>

        <!-- GPX 导入 -->
        <Frame Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="GPX 文件" FontSize="18" FontAttributes="Bold"/>
                <Label Text="标准 GPS 交换格式文件" FontSize="12" TextColor="Gray"/>
                <Button Text="选择 GPX 文件"
                        Command="{Binding ImportGpxCommand}"
                        IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#4CAF50" TextColor="White"/>
            </VerticalStackLayout>
        </Frame>

        <Frame Padding="15">
            <VerticalStackLayout Spacing="10">
                <Label Text="ICS 日历" FontSize="18" FontAttributes="Bold"/>
                <Label Text="从日历文件导入待执行计划" FontSize="12" TextColor="Gray"/>
                <Button Text="选择 ICS 文件"
                        Command="{Binding ImportIcsCommand}"
                        IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="#607D8B" TextColor="White"/>
            </VerticalStackLayout>
        </Frame>

        <!-- 进度 -->
        <ProgressBar Progress="{Binding ImportProgress}" IsVisible="{Binding IsImporting}"/>
        <Label Text="{Binding ImportStatus}" IsVisible="{Binding IsImporting}" FontSize="14"/>

        <!-- 结果 -->
        <Frame IsVisible="{Binding ImportResult, Converter={StaticResource NotNullOrEmptyStringConverter}}"
               Padding="15" BackgroundColor="#E8F5E9">
            <Label Text="{Binding ImportResult}" FontSize="14"/>
        </Frame>

    </VerticalStackLayout>
</ContentPage>
