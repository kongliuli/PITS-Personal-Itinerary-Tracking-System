<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:PITS.MVP.App.Views"
       x:Class="PITS.MVP.App.AppShell"
       Title="PITS"
       Shell.BackgroundColor="{StaticResource BgSurface}"
       Shell.ForegroundColor="{StaticResource TextPrimary}"
       Shell.TitleColor="{StaticResource TextPrimary}"
       Shell.DisabledColor="{StaticResource TextTertiary}"
       Shell.UnselectedColor="{StaticResource TextSecondary}"
       Shell.TabBarBackgroundColor="{StaticResource BgSurface}"
       Shell.TabBarForegroundColor="{StaticResource AccentPrimary}"
       Shell.TabBarUnselectedColor="{StaticResource TextTertiary}"
       Shell.TabBarTitleColor="{StaticResource TextSecondary}">

    <Shell.FlyoutHeader>
        <Grid HeightRequest="180" BackgroundColor="{StaticResource BgCard}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Text="PITS" FontSize="32" FontAttributes="Bold"
                   TextColor="{StaticResource AccentPrimary}" Margin="20,30,20,0"/>
            <Label Grid.Row="1" Text="Personal Itinerary Tracking"
                   FontSize="13" TextColor="{StaticResource TextSecondary}" Margin="20,4,20,20"/>
        </Grid>
    </Shell.FlyoutHeader>

    <TabBar>
        <ShellContent Title="记录"
                      Route="record"
                      ContentTemplate="{DataTemplate views:RecordPage}"/>
        <ShellContent Title="日历"
                      Route="calendar"
                      ContentTemplate="{DataTemplate views:CalendarPage}"/>
        <ShellContent Title="轨迹"
                      Route="map"
                      ContentTemplate="{DataTemplate views:MapPage}"/>
        <ShellContent Title="助手"
                      Route="assistant"
                      ContentTemplate="{DataTemplate views:AIChatPage}"/>
        <ShellContent Title="更多"
                      Route="more"
                      ContentTemplate="{DataTemplate views:MorePage}"/>
    </TabBar>
</Shell>
